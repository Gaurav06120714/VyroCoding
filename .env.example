# =============================================================================
# VyroCoding API — Environment Variables
# Copy this file: cp .env.example apps/api/.env
# Never commit a .env file with real values.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=3003
API_HOST=0.0.0.0
# Comma-separated allowed origins for CORS.
# In production set to your exact frontend domain, e.g.: https://vyrocoding.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Number of trusted reverse-proxy hops in front of this service.
# 1 = single Nginx/ALB; 0 = direct (dev)
PROXY_DEPTH=1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/vyro_coding

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_FROM_CRYPTO_RANDOM
JWT_EXPIRES_IN=7d

# ── Security / Rate limiting ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
IP_HASH_SALT=REPLACE_WITH_RANDOM_HEX_FOR_PRIVACY_PRESERVING_LOGS

# ── Judge0 (code execution) ───────────────────────────────────────────────────
# Self-hosted: https://github.com/judge0/judge0
# RapidAPI (cloud): https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key-here

# ── Collab WebSocket server ───────────────────────────────────────────────────
COLLAB_PORT=1234

# ── Next.js frontend (NEXT_PUBLIC_ vars are safe to expose in browser) ────────
NEXT_PUBLIC_API_URL=http://localhost:3003
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
