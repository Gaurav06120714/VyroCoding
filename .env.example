# =============================================================================
# VyroCoding — Environment Variables
#
# Setup:
#   cp .env.example .env
#   # Then fill in all REPLACE_WITH_* values, or run:
#   bash scripts/docker-init.sh   (auto-generates JWT_SECRET + IP_HASH_SALT)
#
# NEVER commit a .env file with real secrets.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=3003
API_HOST=0.0.0.0
WEB_PORT=3002
COLLAB_PORT=1234

# Comma-separated allowed origins for CORS.
# In production set to your exact frontend domain: https://vyrocoding.com
CORS_ORIGIN=http://localhost:3002

# Number of trusted reverse-proxy hops in front of the API service.
# 1 = single Nginx/ALB; 0 = direct (dev / no proxy)
PROXY_DEPTH=1

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose overrides this automatically — only needed for local non-Docker runs
DATABASE_URL=postgresql://vyrocoding:vyrocoding@localhost:5432/vyro_coding

POSTGRES_USER=vyrocoding
POSTGRES_PASSWORD=vyrocoding
POSTGRES_DB=vyro_coding

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker Compose overrides this automatically
REDIS_URL=redis://localhost:6379
# Optional: set a password for Redis in production (leave blank for dev)
REDIS_PASSWORD=

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 chars; must be a strong random value in production
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_FROM_CRYPTO_RANDOM
JWT_EXPIRES_IN=7d

# ── Security / Rate limiting ──────────────────────────────────────────────────
# Used to hash IP addresses in logs for privacy (GDPR).
# Generate: openssl rand -hex 16
IP_HASH_SALT=REPLACE_WITH_RANDOM_HEX_FOR_PRIVACY_PRESERVING_LOGS

# ── Judge0 (code execution) ───────────────────────────────────────────────────
# Free public instance (rate-limited): https://ce.judge0.com
# RapidAPI cloud (higher limits): https://rapidapi.com/judge0-official/api/judge0-ce
# Self-hosted: https://github.com/judge0/judge0
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# ── VyroLang (native VyroVM execution) ───────────────────────────────────────
# Path to the compiled `vyro` binary (built from ../VyroLang/impl):
#   cd ../VyroLang/impl && cargo build --release
# Then point this at target/release/vyro (absolute path recommended), or leave
# as `vyro` if it's on PATH. VyroLang code runs natively here, not via Judge0.
VYRO_BIN=vyro
VYRO_TIMEOUT_MS=5000

# ── AI — DeepSeek v4 Pro via NVIDIA NIM ──────────────────────────────────────
# Get a free API key at: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=deepseek-ai/deepseek-v4-pro

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up free at https://resend.com — 3,000 emails/month on the free tier.
# Leave empty in development; the API logs reset links to the console instead.
RESEND_API_KEY=
EMAIL_FROM=VyroCoding <noreply@yourdomain.com>

# Full URL of the frontend — used to build password-reset email links
APP_URL=http://localhost:3002

# ── Next.js frontend (NEXT_PUBLIC_ vars are baked into the browser bundle) ────
# These must point to publicly-accessible URLs from the user's browser, not
# Docker-internal hostnames. For production, use your real domain names.
NEXT_PUBLIC_API_URL=http://localhost:3003
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
